{
  "agent": {
    "name": "hanni",
    "ownerName": "YourName" // Used in prompts sent to Claude (e.g. "Working for YourName")
  },
  "server": {
    "port": 3460,
    "webhookPath": "/webhook"
  },
  "linear": {
    "webhookSecret": "<LINEAR_WEBHOOK_SECRET>",
    // Optional: if you use Hookdeck to relay webhooks locally
    "hookdeckRelayToken": "<HOOKDECK_RELAY_TOKEN>",
    "workspaces": {
      "<WORKSPACE_ID>": {
        "name": "MyWorkspace",
        "apiKey": "<lin_api_xxx>", // Linear Personal API Token
        "inReviewStateId": "<IN_REVIEW_STATE_ID>"
      }
    }
  },
  "repositories": [
    {
      "name": "my-repo",
      "github": "user/my-repo",
      "baseBranch": "main",
      "linearWorkspaceId": "<WORKSPACE_ID>",
      "projectKeys": ["My Project"]
    }
  ],
  "provider": "claude",
  "claude": {
    "model": "opus",
    "fallbackModel": "sonnet"
  },
  "paths": {
    "repos": "./repos",
    "worktrees": "./worktrees",
    "logs": "./logs"
  },
  "schedule": {
    "jobs": [
      {
        "name": "hanni-news",              // Job identifier (used as dedup filename)
        "utcHour": 3,                      // UTC 3:00 = JST 12:00
        "utcMinute": 0,
        "slackWorkspaceId": "<SLACK_TEAM_ID>",
        "channel": "<CHANNEL_ID>",
        "repo": "hanni-news",              // Must match a name in `repositories`
        "message": "Deliver today's news digest",
        "initMessage": "📰 Delivering news..." // Optional, default: "⏰ Running..."
      }
    ]
  },
  "slack": {
    "workspaces": {
      "<SLACK_TEAM_ID>": {
        "name": "MyWork",
        "botToken": "<xoxb-xxx>",
        "signingSecret": "<xxx>",
        "defaultLinearWorkspaceId": "<WORKSPACE_ID>",
        "linearApiKey": "<lin_api_xxx>"
      }
    }
  }
}
